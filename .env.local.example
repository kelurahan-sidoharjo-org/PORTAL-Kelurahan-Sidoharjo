# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real values.

# --- Public: also readable in the browser -----------------------------------
# The NEXT_PUBLIC_ prefix means Next.js copies these into the JavaScript every
# visitor downloads. That is fine and intended — they are addresses, not keys.
# Anyone can read them by viewing source.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Absolute URL of the deployed site, no trailing slash. Feeds page metadata,
# Open Graph link previews, sitemap.xml and robots.txt (see src/lib/site.ts).
# Optional in local dev and on Vercel — it falls back to localhost:3000 and to
# Vercel's own production URL respectively. Set it explicitly once the .go.id
# domain is live; that is the only code-side change the cutover needs.
NEXT_PUBLIC_SITE_URL=

# --- Server-only ------------------------------------------------------------
# No NEXT_PUBLIC_ prefix, so Next.js never copies these into the browser
# bundle. Do not add the prefix to any of them.

# Pinned Sanity API date. Leave unset unless you know why you're changing it;
# it must match sanity.config.ts and sanity/assetSources/.
SANITY_API_VERSION=2024-01-01

# Shared secret between the Sanity webhook and /api/revalidate. Sanity sends it
# as the `x-revalidate-secret` header; the route compares it exactly, so the
# value here, the value in Vercel, and the value in the webhook must match
# character for character — no surrounding quotes.
# Generate one with: node -e "console.log(crypto.randomUUID())"
# Needed in Vercel too, and a redeploy is required after adding it.
SANITY_REVALIDATE_SECRET=

# Write-capable token, used ONLY by scripts/seed.mjs from your own terminal:
#   node --env-file=.env.local scripts/seed.mjs --commit
# NEVER add this to Vercel. The deployed site is read-only and has no use for
# it; putting a write key on a public host is pure downside. Create it at
# sanity.io/manage → API → Tokens with Editor permissions.
SANITY_WRITE_TOKEN=
